# Sentinela AI - modelo de variaveis de ambiente
# Copie para server/.env (desenvolvimento) ou cadastre na Vercel (producao).
# NUNCA coloque valores reais neste arquivo nem em qualquer arquivo versionado.

# --- Obrigatorias ---------------------------------------------------------
# Banco PostgreSQL (Neon em producao). Use a URL "pooled" do Neon.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"
# Segredo para assinar os logins (JWT). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor desloga todo mundo (comportamento esperado).
JWT_SECRET=""
# URL publica do sistema (usada nos links dos e-mails)
APP_URL="https://sentinelaai.com.br"

# --- E-mail (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Sentinela AI <notificacoes@sentinelaai.com.br>"
# E-mail que recebe alertas de notificacoes (gestor de risco padrao)
RISK_MANAGER_EMAIL=""

# --- Inteligencia artificial (Groq) ----------------------------------------
GROQ_API_KEY=""

# --- Administracao ---------------------------------------------------------
# Chave do reset de emergencia (/api/auth/emergency-reset). Sem ela o endpoint fica desligado.
ADMIN_SECRET=""
# Usado apenas pelos scripts manuais (reset-admin.ts, migrate-to-inmceb.ts)
ADMIN_EMAIL=""

# --- Pagamentos (Stripe) - opcional enquanto nao houver cobranca ------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# --- LinkedIn (publicacao de artigos) - opcional ----------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""

# --- Frontend (client/.env) ------------------------------------------------
VITE_API_URL=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# --- Execucao --------------------------------------------------------------
NODE_ENV="development"
PORT=3001
